{
  "name": "depcat",
  "version": "0.1.0",
  "description": "Sync catalog: references across pnpm workspace packages",
  "type": "module",
  "bin": {
    "depcat": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zyjared/depcat"
  },
  "scripts": {
    "build": "rolldown -c",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "pnpm version",
    "prepublishOnly": "pnpm check && pnpm typecheck && pnpm test && pnpm build",
    "depcat": "pnpm run build && node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@types/node": "catalog:dev",
    "rolldown": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@inquirer/select": "^5.1.2",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.15",
    "yaml": "^2.8.3"
  }
}
