{
  "name": "depcat",
  "version": "0.0.1",
  "description": "Sync pnpm workspace catalog from a config file",
  "type": "module",
  "bin": {
    "depcat": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zyjared/depcat"
  },
  "scripts": {
    "build": "rolldown -c",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "pnpm version",
    "prepublishOnly": "pnpm check && pnpm typecheck && pnpm test && pnpm build",
    "depcat": "node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@types/node": "catalog:dev",
    "rolldown": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "packageManager": "pnpm@10.33.0"
}
